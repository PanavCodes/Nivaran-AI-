# ── Nivaran AI — docker compose environment (BUILD.md §5.2/§5.3) ──────────
# Copy to .env next to docker-compose.yml:  cp .env.example .

# ── AI Integrations ──────────────────────────────────────────────────────
GEMINI_API_KEY="AIzaSy..."

# ── Demo Failsafe ────────────────────────────────────────────────────────
# Set to 'true' if venue Wi-Fi blocks Gemini ports during the live demo.
# Activates keyword-regex fallback — prevents any 500 error in front of judges.
MOCK_AI=false

# ── Security ─────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-64-char-random-string"

# ── Frontend (bake-time args for the Next.js image) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Clustering Tuning ─────────────────────────────────────────────────────
AUTO_CLUSTER_RADIUS_METERS=50
MIN_SEMANTIC_SIMILARITY_THRESHOLD=0.78
