# ── Database ────────────────────────────────────────────────────────────
# Supabase SESSION pooler (port 5432). The transaction pooler (6543) in
# BUILD.md's example breaks SQLAlchemy prepared statements — use 5432.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── AI Integrations ──────────────────────────────────────────────────────
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# ── Demo Failsafe ────────────────────────────────────────────────────────
# Set to 'true' if venue Wi-Fi blocks Gemini ports during the live demo.
# Activates keyword-regex fallback — prevents any 500 error in front of judges.
MOCK_AI=false

# ── Security ─────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-64-char-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000"
ALLOWED_CORS_ORIGINS='["http://localhost:3000"]'

# ── Clustering Tuning ─────────────────────────────────────────────────────
AUTO_CLUSTER_RADIUS_METERS=50
MIN_SEMANTIC_SIMILARITY_THRESHOLD=0.78
